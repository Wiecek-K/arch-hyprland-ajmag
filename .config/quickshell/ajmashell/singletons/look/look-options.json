    "fancy": { "background": "surface_container", "alpha": 0.8, "motion": true, "flare": true, "glass": true, "softPills": true },
    "fancy2": { "background": "on_primary_fixed", "alpha": 1, "motion": true, "flare": true, "glass": true, "softPills": true },
    "still": { "background": "on_primary_fixed", "alpha": 0.9, "motion": false, "flare": true, "glass": true, "softPills": true }
  },
  "defaults": { "background": "on_primary_fixed", "alpha": 1, "motion": true, "flare": true, "glass": true, "softPills": true }
}
